{
  "name": "safe-client-gateway",
  "description": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "format": "biome format --write",
    "format-check": "biome format",
    "generate-abis": "bun ./scripts/generate-abis.ts",
    "postinstall": "bun run generate-abis",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun --preload ./src/tracing/tracing.ts src/main.ts",
    "lint": "biome check --fix",
    "lint-check": "biome check",
    "test": "bun run test:unit",
    "test:watch": "bun --no-env-file --env-file=.env.test test --watch --path-ignore-patterns='**/*.integration.spec.ts' --path-ignore-patterns='**/*.e2e.spec.ts' src scripts",
    "test:cov": "bun run test:unit:cov",
    "test:debug": "bun --no-env-file --env-file=.env.test test --inspect-brk --path-ignore-patterns='**/*.integration.spec.ts' --path-ignore-patterns='**/*.e2e.spec.ts' src scripts",
    "test:unit": "bun --no-env-file --env-file=.env.test test --parallel --path-ignore-patterns='**/*.integration.spec.ts' --path-ignore-patterns='**/*.e2e.spec.ts' src scripts",
    "test:unit:cov": "bun run test:unit --coverage",
    "test:integration": "bun --no-env-file --env-file=.env.test test --parallel --preload ./test/e2e-setup.ts --timeout=60000 .integration.spec.ts",
    "test:integration:cov": "bun run test:integration --coverage",
    "test:e2e": "bun --no-env-file --env-file=.env.test test --parallel --preload ./test/e2e-setup.ts --timeout=40000 .e2e.spec.ts",
    "test:e2e:cov": "bun run test:e2e --coverage",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "typeorm": "bun ./node_modules/typeorm/cli.js -d ./src/config/entities/orm.config.ts",
    "migration:create": "bun ./node_modules/typeorm/cli.js migration:create ./migrations/${0}",
    "migration:generate": "bun run typeorm migration:generate ./migrations/${0}",
    "migration:run": "bun run typeorm migration:run",
    "migration:revert": "bun run typeorm migration:revert",
    "env:validate": "bun scripts/validate-env-json.ts",
    "env:validate:silent": "bun scripts/validate-env-json.ts --silent",
    "env:generate": "bun scripts/generate-env.ts",
    "env:generate:force": "bun scripts/generate-env.ts --force",
    "env:generate:update": "bun scripts/generate-env.ts --update",
    "generate-token": "bun scripts/generate-token.ts",
    "generate:field-encryption-key": "bun scripts/generate-field-encryption-index-key.ts",
    "backfill:field-encryption": "bun scripts/backfill-field-encryption.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1145.0",
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/client-sesv2": "3.1145.0",
    "@aws-sdk/credential-provider-web-identity": "3.972.78",
    "@aws-sdk/lib-storage": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@blockaid/client": "^1.8.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fingerprintjs/fingerprintjs-pro-server-api": "6.13.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/serve-static": "12.0.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/typeorm": "12.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-amqplib": "0.69.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-ioredis": "0.70.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/instrumentation-redis": "0.70.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@safe-global/safe-deployments": "1.37.63",
    "@safe-global/safe-modules-deployments": "3.0.10",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.0.1",
    "bullmq": "^6.3.11",
    "cache-manager": "7.2.9",
    "csv-stringify": "^6.9.0",
    "ecdsa-sig-formatter": "1.0.11",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "nestjs-cls": "7.0.1",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.0",
    "semver": "7.8.5",
    "typeorm": "1.1.1",
    "viem": "2.57.2",
    "winston": "3.19.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@faker-js/faker": "10.6.0",
    "@nestjs/testing": "12.1.2",
    "@smithy/util-stream": "4.8.2",
    "@types/amqplib": "0",
    "@types/bun": "1.4.2",
    "@types/jsonwebtoken": "9",
    "@types/lodash": "4.17.25",
    "@types/sanitize-html": "2",
    "@types/semver": "7.8.0",
    "@types/supertest": "7.2.1",
    "aws-sdk-client-mock": "4.1.0",
    "husky": "9.1.7",
    "supertest": "7.3.1",
    "typescript": "7.0.2"
  },
  "repository": "https://github.com/5afe/safe-client-gateway-nest.git",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "trustedDependencies": []
}
