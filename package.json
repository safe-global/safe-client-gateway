{
  "name": "safe-client-gateway",
  "description": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "yarn generate-abis && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "biome format --write",
    "format-check": "biome format",
    "generate-abis": "node ./scripts/generate-abis.js",
    "postinstall": "yarn generate-abis",
    "start": "yarn build && node --env-file=.env dist/src/main",
    "start:dev": "yarn build && concurrently --kill-others --names tsc,alias,node \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"tsc-alias -w -p tsconfig.build.json\" \"node --env-file=.env --watch dist/src/main\"",
    "start:debug": "yarn build && concurrently --kill-others --names tsc,alias,node \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"tsc-alias -w -p tsconfig.build.json\" \"node --env-file=.env --watch --inspect dist/src/main\"",
    "start:prod": "node --env-file=.env dist/src/main",
    "lint": "biome check --fix",
    "lint-check": "biome check",
    "test": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run --project unit",
    "test:watch": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest --project unit",
    "test:cov": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run --project unit --coverage",
    "test:debug": "TZ=UTC node --env-file-if-exists=./.env.test --inspect-brk ./node_modules/.bin/vitest run --project unit --no-file-parallelism",
    "test:unit": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run --project unit",
    "test:unit:cov": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run --project unit --coverage",
    "test:integration": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run --project integration",
    "test:integration:cov": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run --project integration --coverage",
    "test:e2e": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run --project e2e",
    "test:e2e:cov": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run --project e2e --coverage",
    "test:all": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run",
    "test:all:cov": "TZ=UTC node --env-file-if-exists=./.env.test ./node_modules/.bin/vitest run --coverage",
    "typeorm": "node --env-file=.env ./node_modules/typeorm/cli -d ./dist/src/config/entities/orm.config.js",
    "migration:create": "node --env-file=.env ./node_modules/typeorm/cli migration:create ./migrations/${0}",
    "migration:generate": "yarn typeorm migration:generate ./migrations/${0}",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "env:validate": "yarn build && node dist/scripts/validate-env-json.js",
    "env:validate:silent": "yarn build && node dist/scripts/validate-env-json.js --silent",
    "env:generate": "yarn build && node dist/scripts/generate-env.js",
    "env:generate:force": "yarn build && node dist/scripts/generate-env.js --force",
    "env:generate:update": "yarn build && node dist/scripts/generate-env.js --update",
    "generate-token": "yarn build && node dist/scripts/generate-token.js",
    "generate:field-encryption-key": "yarn build && node --env-file=.env dist/scripts/generate-field-encryption-index-key.js",
    "backfill:field-encryption": "yarn build && node --env-file=.env dist/scripts/backfill-field-encryption.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1127.0",
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/client-sesv2": "3.1127.0",
    "@aws-sdk/credential-provider-web-identity": "3.972.76",
    "@aws-sdk/lib-storage": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@blockaid/client": "^1.7.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fingerprintjs/fingerprintjs-pro-server-api": "6.12.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "@safe-global/safe-deployments": "1.37.62",
    "@safe-global/safe-modules-deployments": "3.0.9",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.0.1",
    "bullmq": "^6.3.4",
    "cache-manager": "7.2.9",
    "csv-stringify": "^6.8.3",
    "ecdsa-sig-formatter": "1.0.11",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "nestjs-cls": "6.2.1",
    "pg": "8.23.0",
    "postgres": "3.4.9",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "semver": "7.8.5",
    "typeorm": "1.1.1",
    "undici": "8.10.2",
    "viem": "2.56.3",
    "winston": "3.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@faker-js/faker": "10.6.0",
    "@nestjs/testing": "11.2.1",
    "@smithy/util-stream": "4.8.2",
    "@swc/core": "1.16.2",
    "@types/amqplib": "0",
    "@types/jsonwebtoken": "9",
    "@types/lodash": "4.17.25",
    "@types/node": "26.5.0",
    "@types/sanitize-html": "2",
    "@types/semver": "7.8.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "aws-sdk-client-mock": "4.1.0",
    "concurrently": "9.2.4",
    "husky": "9.1.7",
    "supertest": "7.2.2",
    "tsc-alias": "1.9.5",
    "typescript": "7.0.2",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.10"
  },
  "main": "main.ts",
  "repository": "https://github.com/5afe/safe-client-gateway-nest.git",
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "tmp": "0.2.7"
  }
}
