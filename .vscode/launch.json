{
  // Debug configurations for the Bun VS Code extension (oven.bun-vscode).
  // For more information, visit: https://bun.com/docs/runtime/debugger
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "Launch Program",
      "program": "${workspaceFolder}/src/main.ts",
      "cwd": "${workspaceFolder}",
      "watchMode": false,
      "env": {
        "FF_AUTH": "true",
        "FF_DELEGATES_V2": "true",
        "FF_EMAIL": "true",
        "FF_ETH_SIGN": "true",
        "FF_HASH_VERIFICATION_API": "true",
        "FF_HASH_VERIFICATION_PROPOSAL": "true",
        "FF_MESSAGE_VERIFICATION": "true",
        "FF_SIGNATURE_VERIFICATION_API": "true",
        "FF_SIGNATURE_VERIFICATION_PROPOSAL": "true",
        "FF_TRUSTED_DELEGATE_CALL": "true",
        "FF_TRUSTED_FOR_DELEGATE_CALL_CONTRACTS_LIST": "true",
        "FF_USERS": "true"
      }
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug current test file",
      "runtimeArgs": ["test"],
      "program": "${file}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug current integration or E2E test file",
      "runtimeArgs": [
        "test",
        "--preload",
        "./test/e2e-setup.ts",
        "--timeout=60000"
      ],
      "program": "${file}",
      "cwd": "${workspaceFolder}"
    }
  ]
}
