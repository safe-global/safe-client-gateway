{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "statusMessage": "Checking HEAD passed the pre-PR architecture review",
            "timeout": 15,
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-gate.mjs"
          }
        ]
      }
    ]
  }
}
